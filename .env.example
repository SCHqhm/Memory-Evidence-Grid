# Embedding（官方要求 text-embedding-v4）
SCH_EMBED_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
SCH_EMBED_MODEL=text-embedding-v4
SCH_EMBED_DIM=1024
SCH_EMBED_KEY=sk-xxxxxxxx

# LLM（官方要求 gpt-4o-mini）
SCH_LLM_BASE=https://api.openai.com/v1
SCH_LLM_MODEL=gpt-4o-mini
SCH_LLM_KEY=sk-xxxxxxxx

# 鉴权与端口
SCH_KEY=sch-memory
SCH_PORT=8100

# 行为开关
SCH_LLM_FACTS=1
SCH_ASSESS=1
